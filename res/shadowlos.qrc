        <file alias="shadowlos.qss">shadowlos/shadowlos.qss</file>
        <file alias="icons/add-config.png">shadowlos/icons/add-config.png</file>
        <file alias="icons/add-config@2x.png">shadowlos/icons/add-config@2x.png</file>
        <file alias="icons/chart.png">shadowlos/icons/chart.png</file>
        <file alias="icons/chart@2x.png">shadowlos/icons/chart@2x.png</file>
