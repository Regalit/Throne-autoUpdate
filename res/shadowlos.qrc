        <file alias="icons/latency.png">shadowlos/icons/latency.png</file>
        <file alias="icons/latency@2x.png">shadowlos/icons/latency@2x.png</file>
        <file alias="icons/minus.png">shadowlos/icons/minus.png</file>
        <file alias="icons/minus@2x.png">shadowlos/icons/minus@2x.png</file>
        <file alias="icons/radio-dot.png">shadowlos/icons/radio-dot.png</file>
        <file alias="icons/radio-dot@2x.png">shadowlos/icons/radio-dot@2x.png</file>
        <file alias="icons/refresh.png">shadowlos/icons/refresh.png</file>
        <file alias="icons/refresh@2x.png">shadowlos/icons/refresh@2x.png</file>
