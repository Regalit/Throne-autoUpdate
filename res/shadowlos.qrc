        <file alias="icons/chevron-up-light.png">shadowlos/icons/chevron-up-light.png</file>
        <file alias="icons/chevron-up-light@2x.png">shadowlos/icons/chevron-up-light@2x.png</file>
        <file alias="icons/close.png">shadowlos/icons/close.png</file>
